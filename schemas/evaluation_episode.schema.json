{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/weihuaguo270-ops/react-agent/schemas/evaluation_episode.schema.json",
  "title": "Harness Evaluation Episode",
  "description": "Versioned evaluation evidence built on the shared TaskEpisode contract.",
  "type": "object",
  "required": ["schema_version", "episode_id", "query", "runner", "trajectory", "score", "environment"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "evaluation-episode/v1" },
    "episode_id": { "type": "string", "minLength": 1 },
    "query": { "type": "string" },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "split": { "enum": ["dev", "golden", "held_out", "production"] },
    "fixture_ref": { "type": ["string", "null"] },
    "model_ref": { "type": ["string", "null"] },
    "tool_protocol_version": { "type": "string", "minLength": 1 },
    "runner": { "type": "string", "minLength": 1 },
    "batch_id": { "type": "string" },
    "trajectory": { "type": "object" },
    "score": { "type": "object" },
    "artifacts": { "type": "array", "items": { "$ref": "harness_trajectory.schema.json#/$defs/artifact" } },
    "environment": { "type": "object" },
    "created_at": { "type": "string" },
    "fixture_manifest": { "$ref": "fixture_manifest.schema.json" }
  }
}
