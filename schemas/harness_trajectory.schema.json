{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/weihuaguo270-ops/react-agent/schemas/harness_trajectory.schema.json",
  "title": "Harness Trajectory (Format B)",
  "description": "Compatible subset of trace-debugger Format B. Canonical schema: https://github.com/weihuaguo270-ops/trace-debugger/schemas/agent_trajectory.schema.json",
  "type": "object",
  "required": ["session_id", "query", "steps", "final_answer"],
  "additionalProperties": true,
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique run / session id"
    },
    "query": {
      "type": "string",
      "description": "User query for this run"
    },
    "model": {
      "type": "string",
      "description": "Model id used by the agent"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO-8601 timestamp when recording started"
    },
    "system_prompt_preview": {
      "type": "string",
      "description": "Truncated system prompt for debugging"
    },
    "total_steps": {
      "type": "integer",
      "minimum": 0
    },
    "total_duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "total_tokens_estimated": {
      "type": "integer",
      "minimum": 0
    },
    "final_answer": {
      "type": "string",
      "description": "Agent final answer (may be empty if the run failed)"
    },
    "schema_version": {
      "type": "string",
      "description": "Format B wire version major (optional; absent ⇒ treat as \"1\")",
      "pattern": "^[0-9]+(\\.[0-9]+)*$"
    },
    "task_episode_id": {
      "type": "string",
      "description": "Stable id for the eval task / acceptance boundary (maps to eval case id when present)"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Human-readable done conditions for this Task Episode"
    },
    "input_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" },
      "description": "Input media references; binary/base64 content must not be embedded"
    },
    "output_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" },
      "description": "Generated media references associated with the final answer"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["id", "media_type", "uri"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "media_type": { "enum": ["image", "video", "audio", "document", "other"] },
        "uri": { "type": "string", "minLength": 1 },
        "mime_type": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "frame_count": { "type": "integer", "minimum": 0 },
        "metadata": { "type": "object" }
      }
    },
    "toolCall": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Tool / action name"
        },
        "arguments": {
          "description": "Preferred: JSON string of tool args (recorder default)",
          "oneOf": [
            { "type": "string" },
            { "type": "object" }
          ]
        },
        "args": {
          "description": "Accepted alias (object or string); consumers should read arguments || args",
          "oneOf": [
            { "type": "string" },
            { "type": "object" }
          ]
        }
      }
    },
    "step": {
      "type": "object",
      "required": ["step"],
      "additionalProperties": true,
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based step number (Harness Format B). Do not emit 0."
        },
        "thought": { "type": "string" },
        "observation": { "type": "string" },
        "duration_seconds": { "type": "number", "minimum": 0 },
        "tokens_estimated": { "type": "integer", "minimum": 0 },
        "action": { "$ref": "#/$defs/toolCall" },
        "actions": {
          "type": "array",
          "description": "Multi-tool parallel calls in one step; prefer singular action when only one tool",
          "items": { "$ref": "#/$defs/toolCall" },
          "minItems": 1
        }
      }
    }
  }
}
