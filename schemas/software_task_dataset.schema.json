{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weihuaguo270-ops.github.io/react-agent/schemas/software-task-dataset-v1.json",
  "title": "Software Task Dataset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "version", "status", "license", "source_policy", "tasks"],
  "properties": {
    "schema_version": {"const": "software-task-dataset/v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "pending_external_data"]},
    "license": {"type": "string", "minLength": 1},
    "source_policy": {"type": "string", "minLength": 1},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "task_id", "repository", "issue_url", "base_commit", "split", "test_command", "acceptance_criteria", "allowed_paths", "repository_cluster", "source", "build"],
        "properties": {
          "schema_version": {"const": "software-task/v1"},
          "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "repository": {"type": "string", "minLength": 1},
          "issue_url": {"type": "string", "minLength": 1},
          "base_commit": {"type": "string", "minLength": 1},
          "split": {"enum": ["dev", "golden", "held_out"]},
          "test_command": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1}},
          "hidden_test_command": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1}},
          "hidden_test_asset": {"type": ["string", "null"], "minLength": 1},
          "acceptance_criteria": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "minLength": 1}},
          "allowed_paths": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "minLength": 1}},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
          "max_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 100000000},
          "remote_repository": {"type": ["string", "null"], "minLength": 1},
          "idempotency_key": {"type": ["string", "null"], "minLength": 1},
              "repository_cluster": {"type": "string", "minLength": 1},
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "issue_url", "license", "provenance_url"],
                "properties": {
                  "kind": {"const": "external_issue"},
                  "issue_url": {"type": "string", "minLength": 1},
                  "license": {"type": "string", "minLength": 1},
                  "provenance_url": {"type": "string", "minLength": 1}
                }
              },
              "build": {
                "type": "object",
                "additionalProperties": false,
                "required": ["runtime_image", "install"],
                "properties": {
                  "runtime_image": {"type": "string", "minLength": 1},
                  "install": {"type": "array", "items": {"type": "string"}}
                }
              }
        }
      }
    }
  }
}
