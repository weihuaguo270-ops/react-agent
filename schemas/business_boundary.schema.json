{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://react-agent.local/schemas/business-boundary.schema.json",
  "title": "BusinessBoundary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name", "version", "scenario", "purpose", "allowed_tools",
    "required_steps", "required_inputs", "required_outputs",
    "success_conditions", "human_handoff_conditions", "forbidden_actions",
    "risk_level", "agent_callable", "workflow", "owner", "status"
  ],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "allowed_tools": {"type": "array", "items": {"type": "string"}},
    "required_steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "required_inputs": {"type": "array", "items": {"type": "string"}},
    "required_outputs": {"type": "array", "items": {"type": "string"}},
    "success_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "human_handoff_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "forbidden_actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "risk_level": {"type": "string", "enum": ["read_only", "business_write", "external_write"]},
    "agent_callable": {"type": "boolean"},
    "workflow": {"type": "string"},
    "owner": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["active", "experimental", "deprecated"]},
    "supersedes": {"type": "string"},
    "metadata": {"type": "object"}
  }
}
