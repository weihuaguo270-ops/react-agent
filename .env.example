# API Key 配置（按需设置，至少填一个）

# DeepSeek（默认 provider）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# OpenAI
# OPENAI_API_KEY=sk-your-openai-api-key

# 切换 LLM Provider（deepseek / openai / ollama）
# LLM_PROVIDER=deepseek

# DeepSeek 模型（2026-07-24 起勿再用 deepseek-chat / deepseek-reasoner）
# LLM_MODEL=deepseek-v4-flash
# 可选：enabled / disabled（默认 disabled，对齐旧 chat 行为）
# LLM_THINKING=disabled

# Sandbox（生产配置；需先构建 Dockerfile.sandbox）
# REACT_AGENT_SANDBOX_STRATEGY=on
# REACT_AGENT_SANDBOX_BACKEND=container
# REACT_AGENT_SANDBOX_RUNTIME=podman  # Docker 环境改为 docker
# REACT_AGENT_SANDBOX_REQUIRED=1
# REACT_AGENT_SANDBOX_IMAGE=react-agent-sandbox:0.7.0
# REACT_AGENT_SANDBOX_MEMORY=256m
# REACT_AGENT_SANDBOX_CPUS=0.5
# REACT_AGENT_SANDBOX_PIDS=64
# REACT_AGENT_SANDBOX_TMPFS=64m
# REACT_AGENT_SANDBOX_MAX_INPUT=1048576
# REACT_AGENT_SANDBOX_MAX_OUTPUT=65536
# 网络工具仅连接受控 egress proxy 所在的容器网络
# REACT_AGENT_SANDBOX_EGRESS_NETWORK=sandbox-egress

# MySQL 持久化（默认关闭，启用前先创建数据库）
# REACT_AGENT_TASK_STORE=mysql
# REACT_AGENT_MYSQL_URL=mysql://agent_user:password@127.0.0.1:3306/react_agent
# LANGGRAPH_CHECKPOINT_BACKEND=mysql
# LANGGRAPH_MYSQL_URL=mysql://agent_user:password@127.0.0.1:3306/react_agent
# 或使用分项配置（两种后端共用）：
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=agent_user
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=react_agent
