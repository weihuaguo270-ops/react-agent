# API Key 配置（按需设置，至少填一个）

# DeepSeek（默认 provider）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# OpenAI
# OPENAI_API_KEY=sk-your-openai-api-key

# 切换 LLM Provider（deepseek / openai / ollama）
# LLM_PROVIDER=deepseek

# DeepSeek 模型（2026-07-24 起勿再用 deepseek-chat / deepseek-reasoner）
# LLM_MODEL=deepseek-flash
# 可选：enabled / disabled（默认 disabled，对齐旧 chat 行为）
# LLM_THINKING=disabled

# 服务鉴权与网络暴露（服务对外可达时**必设**；完整说明见 docs/DEPLOY.md）
# 共享密钥：设置后除 /health、/ready 探针外所有接口要求 Authorization: Bearer <token>（或 X-Api-Key）
# REACT_AGENT_AUTH_TOKEN=replace-with-32-byte-random-secret
# 兼容别名：等价于 AUTH_TOKEN（两者同时设置时 AUTH_TOKEN 优先），仅供早期 FastAPI 面部署过渡
# REACT_AGENT_API_KEY=
# 反代 / 自定义域名：必须声明真实主机名；默认 loopback 档下非本地 Host 一律返回 421
# REACT_AGENT_ALLOWED_HOSTS=agent.example.com
# 严格档：绑定非回环且未声明 ALLOWED_HOSTS 时拒绝启动（exit 2），让漏配在启动期暴露
# REACT_AGENT_REQUIRE_HOST_ALLOWLIST=1
# 异步人工审批：CONFIRM 级工具（如 execute_python）不再自动放行，改为落盘待批；
# 人工经 GET/POST /v1/approvals 批准后带同一 approval_id 重试。待批目录不可写则失败关闭
# REACT_AGENT_APPROVAL_MODE=async

# Sandbox（生产配置；需先构建 Dockerfile.sandbox）
# REACT_AGENT_SANDBOX_STRATEGY=on
# REACT_AGENT_SANDBOX_BACKEND=container
# REACT_AGENT_SANDBOX_RUNTIME=docker
# REACT_AGENT_SANDBOX_REQUIRED=1
# REACT_AGENT_SANDBOX_IMAGE=react-agent-sandbox:0.7.0
# REACT_AGENT_SANDBOX_MEMORY=256m
# REACT_AGENT_SANDBOX_CPUS=0.5
# REACT_AGENT_SANDBOX_PIDS=64
# REACT_AGENT_SANDBOX_TMPFS=64m
# REACT_AGENT_SANDBOX_MAX_INPUT=1048576
# REACT_AGENT_SANDBOX_MAX_OUTPUT=65536
# 网络工具仅连接受控 egress proxy 所在的容器网络
# REACT_AGENT_SANDBOX_EGRESS_NETWORK=sandbox-egress

# PostgreSQL 持久化（默认关闭，启用前先创建数据库）
# REACT_AGENT_TASK_STORE=postgresql
# REACT_AGENT_DATABASE_URL=postgresql+psycopg://agent_user:password@127.0.0.1:5432/react_agent
# Security Triage 案件库；未设置时依次回退 REACT_AGENT_DATABASE_URL、sqlite:///react_agent_security.db
# REACT_AGENT_SECURITY_DATABASE_URL=sqlite:///react_agent_security.db

# Redis Streams task queue (MVP; PostgreSQL remains the durable task store)
# REACT_AGENT_QUEUE_BACKEND=redis
# Compose 内部使用 redis://redis:6379/0；宿主机连接项目 Redis 使用 6380 映射端口：
# REACT_AGENT_REDIS_URL=redis://127.0.0.1:6380/0
# REACT_AGENT_QUEUE_NAME=react-agent:tasks
# REACT_AGENT_QUEUE_GROUP=react-agent-workers
# REACT_AGENT_QUEUE_VISIBILITY_MS=900000
# REACT_AGENT_QUEUE_MAX_TASKS=10000
# API 宿主机 8765 已被占用时，可在启动 Compose 前设置为 8766。
# REACT_AGENT_API_HOST_PORT=8766

# 企业只读连接器（按需启用；只读 Token 不要提交到 Git）
# Jira Cloud 常用 Basic：JIRA_AUTH_HEADER=Authorization，JIRA_AUTH_SCHEME=Basic，
# JIRA_READONLY_TOKEN 填写 base64(username:api_token)；Jira Server PAT 可使用 Bearer。
# JIRA_BASE_URL=https://jira.example.com
# JIRA_READONLY_TOKEN=replace-with-readonly-secret
# JIRA_AUTH_HEADER=Authorization
# JIRA_AUTH_SCHEME=Bearer

# GitLab：Personal Access Token 常用 PRIVATE-TOKEN 头。
# GITLAB_BASE_URL=https://gitlab.example.com
# GITLAB_READONLY_TOKEN=replace-with-read-api-token
# GITLAB_AUTH_HEADER=PRIVATE-TOKEN
# GITLAB_AUTH_SCHEME=

# Zendesk API Token 常用 Basic 认证（base64(email/token:api_token)）。
# ZENDESK_BASE_URL=https://your-subdomain.zendesk.com
# ZENDESK_READONLY_TOKEN=replace-with-readonly-secret
# ZENDESK_AUTH_HEADER=Authorization
# ZENDESK_AUTH_SCHEME=Basic

# ServiceNow OAuth Bearer 或实例要求的只读认证方式。
# SERVICENOW_BASE_URL=https://your-instance.service-now.com
# SERVICENOW_READONLY_TOKEN=replace-with-readonly-secret
# SERVICENOW_AUTH_HEADER=Authorization
# SERVICENOW_AUTH_SCHEME=Bearer

# APM / Trace 查询服务（需要提供只读 GET 接口）。
# APM_BASE_URL=https://apm.example.com/api
# APM_READONLY_TOKEN=replace-with-readonly-secret
# APM_AUTH_HEADER=Authorization
# APM_AUTH_SCHEME=Bearer
# RAG backend: local JSON (default)。注意：Milvus 后端尚未并入 main，下面这些变量在主干上不会被读取。
# REACT_AGENT_RAG_BACKEND=local
# REACT_AGENT_MILVUS_URI=http://localhost:19530
# REACT_AGENT_MILVUS_TOKEN=
# REACT_AGENT_MILVUS_COLLECTION=react_agent_rag
# REACT_AGENT_MILVUS_DIMENSION=512
# Explicit ANN index (HNSW): M controls graph degree; ef values control build/query recall
# REACT_AGENT_MILVUS_INDEX_TYPE=HNSW
# REACT_AGENT_MILVUS_HNSW_M=16
# REACT_AGENT_MILVUS_HNSW_EF_CONSTRUCTION=200
# REACT_AGENT_MILVUS_HNSW_EF_SEARCH=64
